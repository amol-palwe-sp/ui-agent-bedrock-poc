# Gradle
.gradle/
build/

.DS_Store

# IDE
.idea/
*.iml
.vscode/

# Playwright browser downloads
~/.cache/ms-playwright/

# Python eval harness (evals/) — the venv is ~500MB and machine-specific.
# Recreate with: python3.12 -m venv evals/.venv && pip install sp_agents pytest-xdist
evals/.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.python-version

# Eval outputs — regenerated on every run
eval-reports/
evals/reports/

# Dumped gateway request bodies — multi-MB base64 frames, regenerate with dumpProxyRequest
proxy-requests/

agent-run.jsonl

/src/main/resources/Frames
/bin/

# Secrets — never commit the real properties file if it contains credentials
# (check in application.properties.example instead)
# src/main/resources/application.properties
